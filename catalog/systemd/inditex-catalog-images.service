[Unit]
Description=Private on-demand images for the Vestia catalog
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=catalog-inditex
Group=www-data
WorkingDirectory=/opt/inditex-catalog
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/inditex-catalog/.venv/bin/python /opt/inditex-catalog/image_gateway.py
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/inditex-catalog/viewer
MemoryMax=512M
CPUQuota=80%
Nice=5

[Install]
WantedBy=multi-user.target
