[Unit]
Description=Download and validate queued catalog garment images
Wants=network-online.target
After=network-online.target
[Service]
Type=oneshot
User=catalog-inditex
Group=catalog-inditex
WorkingDirectory=/opt/inditex-catalog
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/inditex-catalog/.venv/bin/python /opt/inditex-catalog/harvest.py media
TimeoutStartSec=7d
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/inditex-catalog
MemoryMax=768M
CPUQuota=60%
Nice=15
