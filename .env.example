# Copy this file to .env and fill in the real values.
# .env is git-ignored on purpose: it holds real credentials and must never be committed.

# Environment this checkout is running as: local | pre | prod
APP_ENV=local
# Absolute origin of this environment. Shared outfits build their public link and their
# preview image from it, and both have to be absolute: the link is pasted into a chat and
# og:image is fetched by a crawler with no page to resolve a relative path against.
APP_URL=http://localhost:8000

# Long random string used to sign sessions. Generate one with:
#   php -r "echo bin2hex(random_bytes(32));"
APP_KEY=change-this-to-a-long-random-secret

# OpenAI: powers the wardrobe analysis and the style reading.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
ANALYSIS_MAX_ITEMS=40

# Accounts exempt from the limit of 2 analyses per hour, comma separated. The seed scripts
# already flag demo and the slot accounts in the database; this is for exempting one more
# without a migration.
RATE_LIMIT_EXEMPT_EMAILS=

# Accounts one IP may open per hour and per day, and accounts one email domain may produce
# per hour. Unset means the defaults in app/SignupLimit.php (10, 30 and 10); 0 switches that
# window off, which is what a personal test slot wants -- registering is the first step of
# nearly every manual test and it should never be the one that runs out.
SIGNUPS_PER_IP_PER_HOUR=
SIGNUPS_PER_IP_PER_DAY=
SIGNUPS_PER_DOMAIN_PER_HOUR=

# Hard ceiling on model calls per calendar day for the whole environment, jobs of every
# kind included. The per-account hourly limit does not cover a retry loop or a bug that
# queues jobs on its own; this does. 0 or unset means no ceiling.
OPENAI_MAX_JOBS_PER_DAY=0

# MySQL. On the VPS each environment has its own database:
#   pre  -> vestia_pre    prod -> vestia_prod
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SOCKET=
DB_DATABASE=vestia_local
DB_USERNAME=vestia
DB_PASSWORD=change-this-database-password

# Base de datos desechable para `php tests/run.php`. Tiene que ser un nombre distinto del
# de DB_DATABASE: las pruebas la borran y la recrean en cada ejecución. Sin esta variable,
# las pruebas que tocan base de datos se omiten y el resto sigue corriendo.
TEST_DB_DATABASE=vestia_tests
