# Environment file with real credentials. Never commit it.
.env
.env.*
!.env.example

# Runtime data: user uploads, generated outfits and logs
/public/uploads/*
!/public/uploads/.gitkeep
/storage/outfits/*
!/storage/outfits/.gitkeep
/storage/shares/*
!/storage/shares/.gitkeep
/storage/style/*
!/storage/style/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep
/storage/*.sqlite*

# Editor and OS noise
.DS_Store
.idea/
.vscode/
*.swp

# Lighthouse/Unlighthouse scan output
.unlighthouse/
