#!/usr/bin/env bash
# Blocks direct pushes to protected branches, so every change goes through a pull request.
# Install once per clone with:  git config core.hooksPath .githooks
# Bypass deliberately with:     git push --no-verify

set -u

protected_branches="main develop"
blocked=0

while read -r _local_ref local_sha remote_ref _remote_sha; do
    # Skip branch deletions: local sha is all zeros.
    case "$local_sha" in
        *[!0]*) ;;
        *) continue ;;
    esac

    branch="${remote_ref#refs/heads/}"

    for protected in $protected_branches; do
        if [ "$branch" = "$protected" ]; then
            echo "pre-push: '$branch' esta protegida, no se hace push directo." >&2
            blocked=1
        fi
    done
done

if [ "$blocked" -eq 1 ]; then
    cat >&2 <<'MSG'

  Los cambios entran por pull request. Crea una rama de trabajo:

      git checkout -b feature/<nombre>
      git push -u origin feature/<nombre>
      gh pr create --base develop --fill

  Ver CONTRIBUTING.md para el flujo completo.
  (Si de verdad necesitas saltarte esto: git push --no-verify)

MSG
    exit 1
fi

exit 0
